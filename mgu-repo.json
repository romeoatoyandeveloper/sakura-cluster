{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "mguHmi": ["ID7"],
    "build": {
      "python": "kit/tools/build.py",
      "args": ["{id}"],
      "sdk": "oap-sdk",
      "shared": ["kit", "shared"],
      "output": "dist/{id}@{version}.tgz"
    }
  },
  "tools": [
    { "id": "psx-core", "path": "native/psx-core" }
  ]
}
