{
  "id": "sport-ambient-pulse",
  "kind": "tool",
  "version": "1.1.0",
  "title": "Sport ambient pulse",
  "description": "Three red pulses of the ambient light when the drive mode goes into Sport (Sport, Sport Plus or Sport Individual), then the light exactly as it was. Through IterioDev's Comfort tool (installed with his Ambient Light app), which must be installed; nothing is coded in the car.",
  "optional": true,
  "uninstallable": true,
  "mguHmi": [
    "ID7"
  ],
  "files": [
    {
      "path": "sport_ambient_pulse.py",
      "from": "sport_ambient_pulse.py",
      "mode": "0755"
    },
    {
      "path": "config.example.json",
      "from": "config.example.json",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "sport-ambient-pulse.service",
      "from": "sport-ambient-pulse.service"
    }
  ],
  "enable": [
    {
      "unit": "sport-ambient-pulse.service",
      "target": "multi-user.target"
    }
  ],
  "restart": [
    "sport-ambient-pulse.service"
  ],
  "versionFiles": [
    "sport_ambient_pulse.py"
  ]
}
